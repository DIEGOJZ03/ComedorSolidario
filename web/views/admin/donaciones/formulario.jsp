<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="titulo" value="Registrar o editar donación"/>
<%@ include file="/views/common/header.jspf" %>
<div class="page-heading"><p class="eyebrow">Administración</p><h1>Registrar o editar donación</h1></div>
<form class="panel row g-3" method="post" action="${ctx}/admin/donaciones"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="guardar"><input type="hidden" name="id" value="${item.id}"><div class="col-md-6"><label class="form-label" for="donanteId">Donador</label><select class="form-select" name="donanteId" id="donanteId" required><option value="">Selecciona</option><c:forEach var="op" items="${donadores}"><option value="${op.id}" ${(pageContext.request.method eq 'POST' ? param.donanteId : item.donanteId) == op.id ? 'selected' : ''}><c:out value="${op.email}"/></option></c:forEach></select></div>
<div class="col-md-6"><label class="form-label" for="comedorId">Comedor</label><select class="form-select" name="comedorId" id="comedorId" required><option value="">Selecciona</option><c:forEach var="op" items="${comedores}"><option value="${op.id}" ${(pageContext.request.method eq 'POST' ? param.comedorId : item.comedorId) == op.id ? 'selected' : ''}><c:out value="${op.nombre}"/></option></c:forEach></select></div>
<div class="col-md-6"><label class="form-label" for="tipo">Tipo</label><select class="form-select" id="tipo" name="tipo" required><option value="ALIMENTOS" ${(pageContext.request.method eq 'POST' ? param.tipo : item.tipo) == 'ALIMENTOS' ? 'selected' : ''}>ALIMENTOS</option><option value="UTENSILIOS" ${(pageContext.request.method eq 'POST' ? param.tipo : item.tipo) == 'UTENSILIOS' ? 'selected' : ''}>UTENSILIOS</option><option value="DINERO" ${(pageContext.request.method eq 'POST' ? param.tipo : item.tipo) == 'DINERO' ? 'selected' : ''}>DINERO</option><option value="OTROS" ${(pageContext.request.method eq 'POST' ? param.tipo : item.tipo) == 'OTROS' ? 'selected' : ''}>OTROS</option></select></div>
<div class="col-md-6"><label class="form-label" for="cantidad">Cantidad</label><input class="form-control" id="cantidad" name="cantidad" type="number" maxlength="20" required min="0.01" max="9999999999.99" step="0.01" value='<c:out value="${pageContext.request.method eq 'POST' ? param.cantidad : item.cantidad}"/>'></div>
<div class="col-md-6"><label class="form-label" for="unidad">Unidad (kg, litros, unidades, cajas o soles)</label><input class="form-control" id="unidad" name="unidad" type="text" maxlength="30" required  value='<c:out value="${pageContext.request.method eq 'POST' ? param.unidad : item.unidad}"/>'></div>
<div class="col-md-6"><label class="form-label" for="descripcion">Descripción</label><input class="form-control" id="descripcion" name="descripcion" type="text" maxlength="1000" required  value='<c:out value="${pageContext.request.method eq 'POST' ? param.descripcion : item.descripcion}"/>'></div>
<div class="col-12"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary" href="${ctx}/admin/donaciones">Volver</a></div></form><%@ include file="/views/common/footer.jspf" %>
