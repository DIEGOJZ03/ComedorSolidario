<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="titulo" value="Guardar donador"/>
<%@ include file="/views/common/header.jspf" %>
<div class="page-heading"><p class="eyebrow">Administración</p><h1>Guardar donador</h1></div>
<form class="panel row g-3" method="post" action="${ctx}/admin/usuarios"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="guardar"><input type="hidden" name="id" value="${item.id}"><div class="col-md-6"><label class="form-label" for="nombre">Nombre</label><input class="form-control" id="nombre" name="nombre" type="text" maxlength="80" required  value='<c:out value="${pageContext.request.method eq 'POST' ? param.nombre : item.nombre}"/>'></div>
<div class="col-md-6"><label class="form-label" for="apellido">Apellido</label><input class="form-control" id="apellido" name="apellido" type="text" maxlength="80" required  value='<c:out value="${pageContext.request.method eq 'POST' ? param.apellido : item.apellido}"/>'></div>
<div class="col-md-6"><label class="form-label" for="email">Correo</label><input class="form-control" id="email" name="email" type="email" maxlength="150" required  value='<c:out value="${pageContext.request.method eq 'POST' ? param.email : item.email}"/>'></div>
<div class="col-md-6"><label class="form-label" for="telefono">Teléfono</label><input class="form-control" id="telefono" name="telefono" type="text" maxlength="20"   value='<c:out value="${pageContext.request.method eq 'POST' ? param.telefono : item.telefono}"/>'></div>
<div class="col-md-6"><label class="form-label" for="estado">Estado</label><select class="form-select" id="estado" name="estado" required><option value="ACTIVO" ${(pageContext.request.method eq 'POST' ? param.estado : item.estado) == 'ACTIVO' ? 'selected' : ''}>ACTIVO</option><option value="INACTIVO" ${(pageContext.request.method eq 'POST' ? param.estado : item.estado) == 'INACTIVO' ? 'selected' : ''}>INACTIVO</option></select></div>
<c:if test="${item.id == 0}"><div class="col-md-6"><label for="password" class="form-label">Contraseña inicial</label><input class="form-control" id="password" name="password" type="password" minlength="8" maxlength="128" required autocomplete="new-password"></div></c:if><div class="col-12"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary" href="${ctx}/admin/usuarios">Volver</a></div></form><%@ include file="/views/common/footer.jspf" %>
