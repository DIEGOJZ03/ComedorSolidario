<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="titulo" value="Guardar campania"/>
<%@ include file="/views/common/header.jspf" %>
<div class="page-heading"><p class="eyebrow">Administración</p><h1>Guardar campania</h1></div>
<form class="panel row g-3" method="post" action="${ctx}/admin/campanias"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="guardar"><input type="hidden" name="id" value="${item.id}"><div class="col-md-6"><label class="form-label" for="comedorId">Comedor</label><select class="form-select" name="comedorId" id="comedorId" required><option value="">Selecciona</option><c:forEach var="op" items="${comedores}"><option value="${op.id}" ${(pageContext.request.method eq 'POST' ? param.comedorId : item.comedorId) == op.id ? 'selected' : ''}><c:out value="${op.nombre}"/></option></c:forEach></select></div>
<div class="col-md-6"><label class="form-label" for="nombre">Nombre de la Campaña</label><input class="form-control" id="nombre" name="nombre" type="text" maxlength="100" required  value='<c:out value="${pageContext.request.method eq 'POST' ? param.nombre : item.nombre}"/>'></div>
<div class="col-md-6"><label class="form-label" for="descripcion">Descripcion</label><input class="form-control" id="descripcion" name="descripcion" type="text" maxlength="1000" required  value='<c:out value="${pageContext.request.method eq 'POST' ? param.descripcion : item.descripcion}"/>'></div>
<div class="col-md-6"><label class="form-label" for="fechaInicio">Fecha inicial</label><input class="form-control" id="fechaInicio" name="fechaInicio" type="date" maxlength="100" required  value='<c:out value="${pageContext.request.method eq 'POST' ? param.fechaInicio : item.fechaInicio}"/>'></div>
<div class="col-md-6"><label class="form-label" for="fechaFin">Fecha final</label><input class="form-control" id="fechaFin" name="fechaFin" type="date" maxlength="100" required  value='<c:out value="${pageContext.request.method eq 'POST' ? param.fechaFin : item.fechaFin}"/>'></div>
<div class="col-md-6"><label class="form-label" for="estado">Estado</label><select class="form-select" id="estado" name="estado" required><option value="ACTIVO" ${(pageContext.request.method eq 'POST' ? param.estado : item.estado) == 'ACTIVO' ? 'selected' : ''}>ACTIVO</option><option value="INACTIVO" ${(pageContext.request.method eq 'POST' ? param.estado : item.estado) == 'INACTIVO' ? 'selected' : ''}>INACTIVO</option></select></div>
<div class="col-12"><button class="btn btn-primary">Guardar</button> <a class="btn btn-outline-secondary" href="${ctx}/admin/campanias">Volver</a></div></form><%@ include file="/views/common/footer.jspf" %>
