<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<div class="row g-4">
    <c:forEach var="c" items="${comedores}">
        <div class="col-md-6 col-xl-4">
            <article class="card comedor-card h-100">
                <div class="comedor-media">
                    <ui:fotoComedor id="${c.id}" nombre="${c.nombre}"/>
                    <span class="location-chip"><ui:icono nombre="pin"/><c:out value="${c.distrito}"/></span>
                </div>
                <div class="card-body d-flex flex-column">
                    <p class="eyebrow"><c:out value="${c.zona}"/> · <c:out value="${c.provincia}"/></p>
                    <h3 class="h4"><c:out value="${c.nombre}"/></h3>
                    <p class="text-secondary card-description"><c:out value="${c.descripcion}"/></p>
                    <p class="comedor-address"><ui:icono nombre="pin"/><c:out value="${c.direccion}"/></p>
                    <a class="card-link-action mt-auto" href="${ctx}/comedores/detalle?id=${c.id}">Conocer y ayudar <ui:icono nombre="arrow"/></a>
                </div>
            </article>
        </div>
    </c:forEach>
</div>
<c:if test="${empty comedores}"><div class="empty-state"><ui:icono nombre="home"/><h3 class="h5 mt-3">Todavía no hay comedores para mostrar</h3><p class="mb-0">Prueba otra ubicación o vuelve más adelante para conocer nuevas comunidades.</p></div></c:if>
